# --- app ---
ANUBIS_APP_IP=0.0.0.0:2222
ANUBIS_APP_ENV=production
ANUBIS_APP_URL=auth.example.com
ANUBIS_APP_VERSION=loacl

# --- postgres ---
ANUBIS_POSTGRES_HOST=postgres
ANUBIS_POSTGRES_PORT=5432
ANUBIS_POSTGRES_USER=anubis_user
ANUBIS_POSTGRES_PASSWORD=super-secret-pass
ANUBIS_POSTGRES_DATABASE=anubis_db
ANUBIS_POSTGRES_SSLMODE=disable
ANUBIS_POSTGRES_MAX_POOL=20

# --- mongo (если используешь) ---
ANUBIS_MONGO_USER=anubis_user
ANUBIS_MONGO_PASSWORD=super-secret-pass
ANUBIS_MONGO_HOST=mongo
ANUBIS_MONGO_PORT=27017
ANUBIS_MONGO_DATABASE=anubis
ANUBIS_MONGO_MAX_POOL=100
ANUBIS_MONGO_TIMEOUT_S=60

# --- jwt ---
ANUBIS_JWT_ACCESS_TOKEN_SECRET=super-secret-access
ANUBIS_JWT_REFRESH_TOKEN_SECRET=super-secret-refresh
ANUBIS_JWT_TICKET_TOKEN_SECRET=super-secret-ticket
ANUBIS_JWT_ACCESS_TOKEN_MINUTE=100
ANUBIS_JWT_REFRESH_TOKEN_MINUTE=1000

# --- list_services.chanki ---
ANUBIS_LIST_SERVICES_CHANKI_SERVICE=anubis
ANUBIS_LIST_SERVICES_CHANKI_STATE_SECRET=state_secret_prod
ANUBIS_LIST_SERVICES_CHANKI_SINGLE_WORKSPACE=false
ANUBIS_LIST_SERVICES_CHANKI_SINGLE_MEMBER=false
ANUBIS_LIST_SERVICES_CHANKI_MAX_DEVICES_USER=3
ANUBIS_LIST_SERVICES_CHANKI_WEBHOOK_TOKEN_REVOKED=https://anubis.business.com/api/token_revoked

ANUBIS_LIST_SERVICES_CHANKI_ROLE_OWNER=O
ANUBIS_LIST_SERVICES_CHANKI_ROLE_ADMIN=A
ANUBIS_LIST_SERVICES_CHANKI_ROLE_USER=U
ANUBIS_LIST_SERVICES_CHANKI_ROLE_GUEST=G

# --- OAuth: Google ---
ANUBIS_LIST_SERVICES_CHANKI_PROVIDER_OAUTH_GOOGLE_CLIENT_ID=google_client_id
ANUBIS_LIST_SERVICES_CHANKI_PROVIDER_OAUTH_GOOGLE_CLIENT_SECRET=google_client_secret
ANUBIS_LIST_SERVICES_CHANKI_PROVIDER_OAUTH_GOOGLE_REDIRECT_URL=https://chanki.example.com/auth/oauth2/callback/google
ANUBIS_LIST_SERVICES_CHANKI_PROVIDER_OAUTH_GOOGLE_REDIRECT=https://business.example.com/ticket

# --- OAuth: Yandex ---
ANUBIS_LIST_SERVICES_CHANKI_PROVIDER_OAUTH_YANDEX_CLIENT_ID=yandex_client_id
ANUBIS_LIST_SERVICES_CHANKI_PROVIDER_OAUTH_YANDEX_CLIENT_SECRET=yandex_client_secret
ANUBIS_LIST_SERVICES_CHANKI_PROVIDER_OAUTH_YANDEX_REDIRECT_URL=https://chanki.example.com/auth/oauth2/callback/yandex
ANUBIS_LIST_SERVICES_CHANKI_PROVIDER_OAUTH_YANDEX_REDIRECT=https://business.example.com/ticket

# --- Telegram Login Widget ---
ANUBIS_LIST_SERVICES_CHANKI_PROVIDER_OAUTH_TELEGRAM_CLIENT_SECRET=telegram_bot_token
ANUBIS_LIST_SERVICES_CHANKI_PROVIDER_OAUTH_TELEGRAM_REDIRECT=https://business.example.com/ticket